{
  "id": "evo2_train",
  "eval_type": "train",
  "domain": "bio",
  "task": "实现 Evo2 风格基因组语言模型的单节点短训练入口",
  "prompt": "实现独立的单节点数据配置、mock-data、max-steps 和 checkpoint 训练流程，实现一个独立于 onescience Python 包的轻量 Evo2 风格训练脚本。请在当前工作目录生成且仅生成 evo2_train.py；脚本必须支持 --dataset-config 与 --mock-data 二选一、--output-dir、--max-steps、--seed；metrics.jsonl 和 evo2_train.pt 必须保存到命令行指定的 --output-dir。",
  "evaluation_script": "evaluate_evo2_train.py",
  "stardard_dir_name": "evo2_train",
  "evaluation_execution_mode": "scnet",
  "evaluation_backend": "ssh",
  "evaluation_env": {
    "conda_env": "onescience311",
    "module": "sghpc-mpi-gcc/26.3",
    "partition": "hx1hdnormal01",
    "nodes": 1,
    "dcu": 1,
    "cpus_per_task": 4,
    "memory": "16G",
    "time_limit": "00:15:00",
    "job_name": "eval_evo2_train"
  },
