          "--mock-data",
          "--output-dir",
          "--max-steps",
          "--seed",
          "metrics.jsonl",
          "model_state_dict"
        ],
        "required_attribute_names": [
          "AdamW",
          "backward",
          "clip_grad_norm_"
        ]
      }
    },
    {
