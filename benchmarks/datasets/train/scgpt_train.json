      "id": "0517c810ad64f924",
      "type": "task_file",
      "method": "check_files",
      "phase": "task_artifacts",
      "depends": [],
      "params": {
        "candidate_file": "scgpt_train.py",
        "candidate_module_name": "scgpt_train_candidate",
        "reference_module_name": "scgpt_train_reference",
        "reference_model_file": "benchmarks/standard/scgpt_train/scgpt_train.py",
        "reference_asset_config": "benchmarks/standard/scgpt_train/train_config.json",
        "external_assets": {
          "mount_required": true,
          "required_existing_paths": [
            "/public/share/sugonhpcapp01/onestore/onemodels/scGPT/scGPT_human",
