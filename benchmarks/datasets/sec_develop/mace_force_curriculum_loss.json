{
  "id": "mace_force_curriculum_loss",
  "eval_type": "sec-develop",
  "domain": "matchem",
  "task": "为 MACE 能量-力联合损失增加力项预热调度",
  "prompt": "完成一次 MACE 训练损失组件二次开发：在保持 MACE 原生构型权重、逐原子能量归一化、逐构型力权重和分布式归约语义的基础上，为能量-力联合损失增加 force curriculum。训练步数不大于 0 时不计入力损失，预热区间内力项权重从 0 线性增长，达到预热步数后保持完整力项权重；能量项权重始终不变。生成文件必须保存为 mace_force_curriculum_loss.py，并定义继承 torch.nn.Module 的公开类 MACEForceCurriculumLoss；构造参数为 energy_weight=1.0、forces_weight=1.0、warmup_steps=100，forward 参数为 reference、prediction、step、ddp=None，并返回可反向传播的标量损失。warmup_steps 必须为正数。",
  "evaluation_script": "evaluate_mace_force_curriculum_loss.py",
  "stardard_dir_name": "mace_force_curriculum_loss",
  "evaluation_execution_mode": "scnet",
  "evaluation_backend": "ssh",
  "evaluation_env": {
    "conda_env": "onescience311",
    "partition": "hx1hdnormal01",
    "nodes": 1,
    "dcu": 1,
    "cpus_per_task": 8,
    "memory": "16G"
  },
  "checks": [
