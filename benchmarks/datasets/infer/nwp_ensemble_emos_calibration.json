          "start": -2.0,
          "stop": 2.0,
          "num": 48,
          "dtype": "float",
          "shape": [
            2,
            4,
            6
          ]
        },
        "reports": [
          {
            "name": "mean_rmse",
            "error": "candidate.mean-reference.mean",
            "value": "sqrt(mean(error*error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          },
          {
            "name": "mean_mae",
            "error": "candidate.mean-reference.mean",
            "value": "mean(abs(error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          },
          {
            "name": "spread_rmse",
            "error": "candidate.spread-reference.spread",
            "value": "sqrt(mean(error*error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          },
          {
            "name": "spread_mae",
            "error": "candidate.spread-reference.spread",
            "value": "mean(abs(error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          },
          {
            "name": "quantiles_rmse",
            "error": "candidate.quantiles-reference.quantiles",
            "value": "sqrt(mean(error*error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          },
          {
            "name": "quantiles_mae",
            "error": "candidate.quantiles-reference.quantiles",
            "value": "mean(abs(error))",
            "pass_condition": "max(abs(error)) <= 1e-10"
          }
        ]
      }
    }
  ]
