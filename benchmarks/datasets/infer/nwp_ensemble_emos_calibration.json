              0.9
            ]
          },
          "scale": {
            "finite": true,
            "greater_than": 0
          }
        }
      }
    },
    {
      "id": "20c328a3142ed711",
      "type": "infer_interface",
      "method": "check_interface",
      "phase": "infer_script",
      "depends": [
        "4b43b53c5acadfc5"
      ],
      "params": {
        "files": [
          "nwp_ensemble_emos_calibration.py"
        ],
        "class_name": "NWPEnsembleEMOS",
        "required_interfaces": [
          "NWPEnsembleEMOS.predict",
          "NWPEnsembleEMOS.load_checkpoint"
        ]
      }
    },
    {
      "id": "fb41705c92eaae4a",
      "type": "infer_method_correctness",
      "method": "check_method_correctness",
      "phase": "infer_script",
      "depends": [
        "154594156941afd5",
        "20c328a3142ed711"
      ],
      "params": {
        "source_file": "nwp_ensemble_emos_calibration.py",
        "class_name": "NWPEnsembleEMOS",
        "constructor_args": {},
        "probes": [
          {
            "name": "output_shapes_and_member_permutation_invariance",
            "ensemble": {
              "generator": "arange",
              "count": 30,
              "dtype": "float",
              "shape": [
                2,
                5,
                3
              ]
            },
            "permutation": {
              "axis": 1,
              "order": "reverse"
            },
            "assertions": {
              "keys": [
                "mean",
                "spread",
                "quantiles"
              ],
              "shapes": {
                "mean": [
                  2,
                  3
                ],
                "spread": [
                  2,
                  3
                ],
                "quantiles": [
                  2,
                  3,
                  3
                ]
              },
              "allclose_each_output_to_permuted": true
            }
          },
          {
            "name": "spread_positive",
            "ensemble": {
              "generator": "arange",
              "count": 30,
              "dtype": "float",
              "shape": [
                2,
                5,
                3
              ]
            },
            "assertions": {
              "field": "spread",
              "all_greater_than": 0
            }
          },
          {
            "name": "quantiles_strictly_ordered",
            "ensemble": {
              "generator": "arange",
              "count": 30,
              "dtype": "float",
              "shape": [
                2,
                5,
                3
              ]
            },
            "assertions": {
              "field": "quantiles",
              "np_diff_axis": -1,
              "all_greater_than": 0
            }
          },
          {
            "name": "member_count_one_rejected",
            "ensemble": {
              "shape": [
                1,
                1,
                3
              ],
              "fill": 0.0
            },
            "expected_exception": "ValueError"
          },
          {
            "name": "nonfinite_rejected",
            "ensemble_expression": "np.array([[np.nan, 0.0], [1.0, 2.0]])",
            "expected_exception": "ValueError"
          }
        ]
      }
    },
    {
      "id": "ff4ef66e64a38df9",
      "type": "infer_output_equivalence",
      "method": "check_evaluate_oracle",
      "phase": "infer_metric",
      "depends": [
