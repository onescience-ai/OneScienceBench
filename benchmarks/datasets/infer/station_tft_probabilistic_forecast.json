        "metrics": [
          {
            "name": "pinball_loss",
            "candidate_quantiles": "candidate_output.quantiles.detach()",
            "reference_quantiles": "reference_output.quantiles.detach()",
            "formula": "mean(max(levels*(target.unsqueeze(-1)-quantiles),(levels-1)*(target.unsqueeze(-1)-quantiles)))",
