            "name": "rollout_rmse",
            "formula": "float(torch.sqrt(torch.mean((candidate_rollout-reference_rollout).detach().square())))",
            "comparison": "less_than_or_equal",
            "threshold": 1e-06
          },
          {
            "name": "rollout_mae",
            "formula": "float(torch.mean((candidate_rollout-reference_rollout).detach().abs()))",
