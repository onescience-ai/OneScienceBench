      ],
      "params": {
        "source_file": "neuralgcm_physics_coupled_inference.py",
        "class_name": "NeuralGCMInference",
        "forward_shape_probe": {
          "model_eval": true,
          "state": "torch.randn(2,4,8,12)",
          "assert_output_shape_equals_state": true,
          "required_successful_calls": [
            {
              "method": "rollout",
              "args": {
                "state": "same_state",
                "steps": 3
              }
            },
            {
              "method": "rollout",
              "args": {
                "state": "same_state",
                "steps": 2,
                "forcing": "torch.zeros_like(state)"
              }
            },
            {
              "method": "rollout",
              "args": {
                "state": "same_state",
                "steps": 2,
                "forcing": "torch.ones_like(state)"
              }
            }
          ]
        },
        "forward_finite_probe": {
          "state": "torch.randn(2,4,8,12)",
          "require_finite": true
        },
        "rollout_shape_probe": {
          "state": "torch.randn(2,4,8,12)",
          "steps": 3,
          "expected_shape": [
            3,
            2,
            4,
            8,
            12
          ]
        },
        "rollout_no_grad_probe": {
          "state": "torch.randn(1,4,4,4)",
          "steps": 2,
          "expected_requires_grad": false
        },
        "input_immutable_probe": {
          "model_eval": true,
          "state": "torch.randn(1,4,4,4)",
          "steps": 2,
          "comparison": "torch.equal(before,after)"
        },
        "forcing_effect_probe": {
          "model_eval": true,
          "state": "torch.zeros(1,4,4,4)",
          "steps": 2,
          "zero_forcing": "torch.zeros_like(state)",
          "one_forcing": "torch.ones_like(state)",
          "assertion": "not torch.allclose(zero_forcing_rollout,one_forcing_rollout)"
        },
        "invalid_steps_probe": {
          "state": "torch.randn(1,4,4,4)",
          "steps": 0,
          "expected_exception": "ValueError"
        }
      }
    },
