{
  "id": "stormcast_paper_repro",
  "eval_type": "paper-repro",
  "domain": "earth",
  "task": "复现 StormCast 条件扩散去噪器与随机高分辨率天气采样链路",
  "prompt": "复现 StormCast 论文中的条件生成式天气预报核心：以低分辨率或确定性预报条件场和高分辨率 noisy state 为输入，通过独立条件投影、扩散 timestep embedding 以及残差卷积去噪块预测噪声，并提供从噪声逐步修正的 sample 接口；实现真实 AdamW、噪声 MSE、backward 训练步和 MAE/RMSE 评估。请在 stormcast_paper_repro 目录生成 stormcast.py、train.py 和 evaluate.py；stormcast.py 定义 StormCast，构造参数至少包含 in_channels、cond_channels、base_channels、num_steps，forward(noisy,conditioning,timestep) 返回与 noisy 同 shape 的有限张量，sample(conditioning,steps,generator) 支持固定 generator 的可重复采样，并对 batch、通道、网格和 timestep 长度进行严格校验。",
  "evaluation_script": "evaluate_stormcast_paper_repro.py",
  "stardard_dir_name": "stormcast_paper_repro",
  "evaluation_execution_mode": "scnet",
  "evaluation_backend": "ssh",
  "evaluation_env": {
    "conda_env": "onescience311",
    "partition": "hx1hdnormal01",
    "nodes": 1,
    "dcu": 1,
    "cpus_per_task": 8,
    "memory": "16G",
    "modules": ["sghpc-mpi-gcc/26.3"]
  },
  "checks": [
    {
      "id": "db8e2905db4d4db0",
      "type": "model_file",
      "phase": "model_structure",
      "method": "check_files",
      "params": {"required_files": ["stormcast.py"]},
      "depends": []
    },
    {
      "id": "ac81eccdc8d7412b",
      "type": "model_interface",
      "phase": "model_structure",
      "method": "check_interface",
      "params": {
        "files": ["stormcast.py"],
        "required_interfaces": ["StormCast", "StormCast.forward", "StormCast.sample"]
      },
      "depends": ["db8e2905db4d4db0"]
    },
    {
      "id": "022488ce9c114709",
      "type": "model_structure",
      "phase": "model_structure",
      "method": "check_model_structure",
      "params": {
        "model_file": "stormcast.py",
        "model_class": "StormCast",
        "model_args": {
          "in_channels": 1,
          "cond_channels": 2,
          "base_channels": 8,
          "num_steps": 20
        },
        "rules": [
          {
            "id": "stormcast_structure:input_projection",
            "type": "conv_shape",
            "severity": "error",
            "params": {
              "target_role": "input_projection",
              "in_channels": "$in_channels",
              "out_channels": "$base_channels"
            }
          },
          {
            "id": "stormcast_structure:conditioning_projection",
            "type": "conv_shape",
            "severity": "error",
            "params": {
              "target_role": "conditioning_projection",
              "in_channels": "$cond_channels",
              "out_channels": "$base_channels"
            }
          },
          {
            "id": "stormcast_structure:residual_convolution",
            "type": "conv_shape",
            "severity": "error",
            "params": {
              "target_role": "residual_convolution",
              "in_channels": "$base_channels",
              "out_channels": "$base_channels"
            }
          },
          {
            "id": "stormcast_structure:output_projection",
            "type": "conv_shape",
            "severity": "error",
            "params": {
              "target_role": "output_projection",
              "in_channels": "$base_channels",
              "out_channels": "$in_channels"
            }
          }
        ]
