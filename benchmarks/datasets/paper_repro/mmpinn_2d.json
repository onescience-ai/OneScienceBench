            300,
            300,
            1
          ],
          "lb": [
            -1.0,
            0.0
          ],
          "ub": [
            1.0,
            1.0
          ],
          "sigma": 10.0
        },
        "device": "cpu",
        "state_alignment": {
          "operation": "generated_model.load_state_dict(reference_model.state_dict(),strict=True)",
          "strict": true
        },
        "mode": "eval",
        "forwards_under_no_grad": true,
        "input": {
          "x": "torch.linspace(-1.0,1.0,64)",
          "t": "torch.linspace(1.0,0.0,64)",
          "construction": "torch.stack((x,t),dim=1)"
        },
        "require_same_shape": true,
        "comparison": {
          "method": "torch.allclose",
          "atol": 1e-06,
          "rtol": 1e-06
        }
      }
    },
    {
      "id": "63fd11ba3790f697",
      "type": "training",
      "method": "check_training",
      "phase": "train",
      "depends": [
        "82a9ff403f408eaf",
        "42072d3ab73c5bc5"
      ],
      "params": {
        "seed": 20260817,
        "device": "cpu",
        "layers": [
          32,
          32,
          1
        ],
        "model_args": {
          "lb": [
            -1.0,
            0.0
          ],
          "ub": [
            1.0,
            1.0
          ],
          "sigma": 10.0
        },
        "reference_model_directory": "benchmarks/standard/mmpinn_2d",
        "state_alignment": {
          "operation": "generated_model.load_state_dict(reference_model.state_dict(),strict=True)",
          "strict": true
        },
        "model_mode": "train",
        "optimizer": {
          "class": "torch.optim.Adam",
          "parameters": "generated_model.parameters()",
          "lr": 0.001
        },
        "comparison_coordinates": {
          "x": "torch.linspace(-1.0,1.0,64)",
          "t": "torch.linspace(1.0,0.0,64)",
          "construction": "torch.stack((x,t),dim=1)[:8].clone().requires_grad_(True)"
        },
        "physics_loss": {
          "first_derivative": "torch.autograd.grad(output,coordinates,grad_outputs=torch.ones_like(output),create_graph=True)[0]",
          "u_x": "first[:,0:1]",
          "u_t": "first[:,1:2]",
          "u_xx": "torch.autograd.grad(u_x,coordinates,grad_outputs=torch.ones_like(u_x),create_graph=True)[0][:,0:1]",
          "residual": "torch.mean((u_t-u_xx)**2)",
          "initial": "torch.mean(model(torch.cat((x,zeros),dim=1))**2)",
          "boundary_target": "torch.sin(2.0*torch.pi*t)",
          "boundary": "torch.mean((lower-target)**2)+torch.mean((upper-target)**2)",
          "epsilon": "torch.finfo(output.dtype).eps",
          "loss": "torch.pow(initial+boundary+epsilon,1.0/3.0)+torch.pow(residual+epsilon,1.0/3.0)"
        },
        "generated_step": {
          "snapshot_all_trainable_named_parameters": true,
          "zero_grad": true,
          "backward": true,
          "collect_gradient_only_when_non_none_and_all_finite": true,
          "optimizer_step": true,
          "require_finite_loss": true,
          "require_no_missing_trainable_gradients": true,
          "require_every_trainable_parameter_changed": true
        },
        "reference_comparison": {
          "reference_zero_grad": true,
          "reference_backward": true,
          "require_identical_finite_gradient_name_sets": true,
          "loss_absolute_difference_at_most": 1e-06,
          "max_common_gradient_absolute_difference_at_most": 1e-06,
          "empty_common_gradient_max_difference": "infinity"
        }
      }
    },
