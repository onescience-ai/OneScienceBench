            0.0
          ],
          "ub": [
            1.0,
            1.0
          ],
          "sigma": 10.0
        },
        "device": "cpu",
        "reference_model": {
          "directory": "benchmarks/standard/mmpinn_2d",
          "same_constructor_args": true
