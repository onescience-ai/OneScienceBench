            "lb",
            "ub",
            "sigma"
          ]
        },
        "state_dict": {
          "require_no_missing_reference_keys": true,
          "require_no_extra_generated_keys": true,
          "require_same_shape_for_every_common_key": true
        },
        "components": {
          "weights_type": "torch.nn.ParameterList",
          "biases_type": "torch.nn.ParameterList",
          "every_named_parameter_prefix_any_of": [
            "weights.",
            "biases."
          ],
          "required_named_buffers": [
            "lb",
            "ub",
            "W"
          ],
          "lb_allclose": [
            -1.0,
            0.0
          ],
          "ub_allclose": [
            1.0,
            1.0
          ]
        }
      }
    },
    {
      "id": "42072d3ab73c5bc5",
      "type": "model_forward",
      "method": "check_model_forward_executable",
      "phase": "model_structure",
      "depends": [
        "82a9ff403f408eaf"
      ],
      "params": {
        "model_file": "model.py",
        "model_class": "PINN2D",
        "model_args": {
          "layers": [
            300,
            300,
            300,
            300,
            1
          ],
          "lb": [
            -1.0,
            0.0
          ],
          "ub": [
            1.0,
            1.0
          ],
          "sigma": 10.0
        },
        "device": "cpu",
        "mode": "eval",
        "forwards_under_no_grad": true,
        "input": {
          "x": "torch.linspace(-1.0,1.0,64)",
          "t": "torch.linspace(1.0,0.0,64)",
          "construction": "torch.stack((x,t),dim=1)",
          "shape": [
            64,
            2
          ]
        },
        "expected_output_type": "torch.Tensor",
        "expected_output_shape": [
          64,
          1
        ],
        "require_all_finite": true
      }
    },
    {
      "id": "db9ec02c9bacb605",
      "type": "model_forward_equivalence",
      "method": "check_model_forward_equivalence",
      "phase": "model_structure",
      "depends": [
        "82a9ff403f408eaf",
        "42072d3ab73c5bc5"
      ],
      "params": {
        "seed": 20260817,
        "candidate_model": {
          "model_file": "model.py",
          "model_class": "PINN2D"
        },
        "reference_model": {
          "directory": "benchmarks/standard/mmpinn_2d",
          "model_file": "model.py",
          "model_class": "PINN2D"
        },
        "model_args": {
          "layers": [
            300,
