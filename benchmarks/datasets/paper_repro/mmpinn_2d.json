{
  "id": "mmpinn_2d",
  "eval_type": "paper-repro",
  "domain": "cfd",
  "task": "复现 MMPINN 论文(arXiv:2308.06672) Section 4.5 multi-frequency 2D 模型（物理信息神经网络多尺度偏微分方程数值求解）",
  "prompt": "复现论文《A practical PINN framework for multi-scale problems with multi-magnitude loss terms》(arXiv:2308.06672) Section 4.5 multi-frequency 模型，以论文描述为准，仅在论文未明确说明时参考官方 Git 仓库代码补充细节，禁止直接下载或复制官方 Git 仓库代码。训练数据由脚本按论文参数采样生成，不从产物目录读取外部文件。复现模型文件为 model.py，主类为 PINN2D，训练脚本为 train.py，配置文件为 config.yaml，checkpoint 保存为 model_2d.pth，结果保存至训练产物目录（含 u 的 1.mat），训练过程中的 loss 和相对 L2 误差通过 print 实时输出",
  "evaluation_script": "evaluate_mmpinn_2d.py",
  "stardard_dir_name": "mmpinn_2d",
  "evaluation_execution_mode": "scnet",
  "evaluation_backend": "local",
  "evaluation_env": {
    "conda_env": "onescience311",
    "partition": "hx1hdnormal01"
  },
  "checks": [
    {
      "id": "6c2b7698387b580b",
      "type": "task_file",
      "method": "check_files",
      "phase": "task_artifacts",
      "depends": [],
      "params": {
        "required_files": [
          "model.py",
          "train.py",
          "config.yaml"
        ],
        "required_file_predicate": "Path.is_file"
      }
    },
    {
      "id": "0dddb155cffb7cb9",
      "type": "data_method_correctness",
      "method": "check_method_correctness",
      "phase": "data_analysis",
      "depends": [
        "6c2b7698387b580b"
      ],
      "params": {
        "file": "train.py",
        "forbidden_ast_call_names": [
          "np.load",
          "numpy.load",
          "sio.loadmat",
          "scipy.io.loadmat",
          "pd.read_csv",
          "pandas.read_csv",
          "h5py.File"
        ],
        "forbidden_reader_result": "no intersection with train.py AST call names",
        "required_sampling_source_terms": [
          "latin",
          "lhs(",
          "qmc",
          "random.permutation",
          "torch.rand"
        ],
        "sampling_match": "case-insensitive substring any",
        "compact_source_normalization": "lowercase then remove all whitespace",
        "required_exact_solution_compact_terms": [
          "sin(",
          "20",
          "pi",
          "1+9"
        ],
        "required_x_squared_any_of": [
          "x**2",
          "x*x"
        ]
      }
    },
    {
      "id": "935f59835ce3532a",
      "type": "train_structure",
      "method": "check_train_structure",
      "phase": "train_script",
      "depends": [
        "6c2b7698387b580b",
        "0dddb155cffb7cb9"
      ],
      "params": {
        "file": "train.py",
        "config_file": "config.yaml",
        "entrypoint": {
          "top_level_function": "main",
          "required_source_substring": "__main__"
        },
        "pde_autodiff": {
          "required_lowercase_substrings": [
            "autograd.grad",
            "source"
          ],
          "required_case_sensitive_substrings": [
            "u_t",
            "u_xx"
          ]
        },
        "multi_magnitude_loss": {
          "required_any_source_terms": [
            "torch.pow",
            "** p",
            "**p"
          ],
          "first_exponent": 0.3333333333333333,
          "first_exponent_source_fallbacks": [
            "1.0 / 3",
            "1 / 3",
            "1/3"
          ],
          "required_lowercase_terms": [
            "ic",
            "bc",
            "res"
          ]
        },
        "optimizer_order": {
          "first": "torch.optim.adam",
          "last": "torch.optim.lbfgs",
          "require_first_index_less_than_last_index": true
        },
        "lbfgs_segments": {
          "expected_exponents": [
            0.3333333333333333,
            0.5,
            1.0
          ],
          "numeric_match_tolerance": 1e-08,
          "source_fallbacks": [
            "1.0 / 3",
            "1 / 3",
            "1/3",
            "1.0 / 2",
            "1 / 2",
            "1/2"
          ],
          "source_fallback_requires_one_third_and_one_half": true
        },
        "config_number_extraction": "recursively traverse dict/list/tuple leaves and parse numbers or numerator/denominator strings",
        "config_driven": {
          "required_source_substring": "config.yaml",
          "required_any_source_terms": [
            "yaml",
            "omegaconf",
            "hydra"
          ]
        },
        "live_reporting": {
          "required_source_substring": "print(",
          "required_lowercase_terms": [
            "loss",
            "l2"
          ]
        }
      }
    },
    {
      "id": "6e81f94a608deccf",
      "type": "infer_structure",
      "method": "check_infer_structure",
      "phase": "infer_script",
      "depends": [
        "6c2b7698387b580b"
      ],
      "params": {
        "file_candidates": [
          "evaluate.py",
          "eval.py",
          "inference.py"
        ],
        "selection": "first existing regular file in candidate order",
        "absence_is_pass": true,
        "when_present": {
          "checkpoint_restore": {
            "required_lowercase_substrings": [
              "torch.load",
              "load_state_dict"
            ]
          },
          "relative_l2": {
            "required_lowercase_substring": "l2",
            "required_any_source_terms": [
              "linalg.norm",
              "relative",
              "rel_error"
            ]
          },
          "inference_mode": {
            "required_case_sensitive_substring": ".eval(",
            "required_any_source_terms": [
              "no_grad",
              "inference_mode"
            ]
          },
          "reports_or_saves": {
            "required_case_sensitive_substring": "print(",
            "alternative_source_terms": [
              "savemat",
              "json.dump"
            ]
          }
        }
      }
    },
    {
      "id": "82a9ff403f408eaf",
      "type": "model_structure",
      "method": "check_model_structure",
      "phase": "model_structure",
      "depends": [
        "6c2b7698387b580b"
      ],
      "params": {
        "model_file": "model.py",
        "model_class": "PINN2D",
        "constructor_args": {
          "layers": [
            300,
            300,
            300,
            300,
            1
          ],
          "lb": [
